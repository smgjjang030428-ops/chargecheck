# 이 파일을 복사해서 `.env` 로 만들고 값을 채운다. .env 는 .gitignore 로 제외돼 있다.
# 공공데이터포털 > 마이페이지 > 활용신청 현황 > 한국환경공단_전기자동차 충전소 정보 > 일반 인증키(디코딩 형태 그대로)
PUBLIC_API_KEY=
# 로컬은 SQLite, 배포는 postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./chargecheck.db
# 운영 DB(Neon) 주소 보관용. 서버는 읽지 않는다. Render의 DATABASE_URL과 copy_db --to에 쓴다
DATABASE_URL_NEON=
# 동기화할 시·도 코드(11=서울). 쉼표로 여러 개. ALL = 전국
PUBLIC_ZCODES=11
# 기기 ID 해시 솔트. 운영에서는 반드시 바꾼다
DEVICE_SALT=dev-salt-change-me
# 운영사 화면 접근 키(/operator?key=…). 배포에서는 반드시 채운다. 비우면 누구나 볼 수 있다
OPERATOR_KEY=
